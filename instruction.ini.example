# Oracle Update Monitor — Project Instructions
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to instruction.ini and customise it for your project.
# The AI uses this file to judge relevance and assign impact levels.
# The [Scope] section is also used to detect if any Oracle modules you need
# are missing from the current crawl list.
# After editing, click 🔄 Reload in the UI (Project Config ⚙) to refresh.
# ─────────────────────────────────────────────────────────────────────────────

[Project]
# Describe your project, technology stack, and team context
description = We are implementing Oracle HCM Cloud for a mid-size enterprise.
    Our team manages Compensation, Recruiting, and Human Resources modules.
    We have custom integrations with a payroll vendor and an internal BI tool.

[Scope]
# Oracle modules and services your project uses (comma-separated).
# This list is compared against current crawl sources to detect missing coverage.
modules = Compensation, Recruiting, Human Resources, HCM Common, Common Technologies and User Experience

# External systems your Oracle implementation integrates with (e.g. payroll vendor, BI tool).
# Used by the AI during Mark Impact to judge whether an Oracle change affects your integrations.
# Has no effect with rule-based classification or during crawl.
integrations = Payroll system, Business Intelligence tool

[Context]
# Describe what matters most to your team in plain language.
# The AI reads this to intelligently judge impact — no rigid keyword rules.
# Example: explain which modules are business-critical, what kinds of changes
# would cause disruption, and what your team generally monitors vs. acts on.
notes = Compensation is our most critical module — any changes to calculation rules,
    REST APIs, or payroll integration require immediate review.
    Recruiting workflow changes are secondary priority.
    Pure documentation updates or cosmetic UI changes rarely require action.

[Crawl]
# Extra HCM module keywords added automatically by the Coverage Check feature.
# You can also add keywords manually here — they are merged with HCM_MODULE_KEYWORDS in .env.
# Comma-separated Oracle module names.
extra_keywords =
