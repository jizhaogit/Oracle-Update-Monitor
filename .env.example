# Oracle OCI/OIC Monitor — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options:
#   "anthropic" — Anthropic API key (sk-ant-...)
#   "bedrock"   — AWS Bedrock via SSO (no Anthropic key needed)
#   "openai"    — OpenAI API key
#   "ollama"    — Local Ollama (free, runs on your machine)
#   "none"      — Rule-based fallback only (default, no AI key required)
LLM_PROVIDER=none

# Max seconds for a single LLM classification call before falling back to rule-based
LLM_TIMEOUT=15

# ── Option 1: Anthropic direct API (LLM_PROVIDER=anthropic) ───────────────────
# Get key from platform.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Option 2: AWS Bedrock via company SSO (LLM_PROVIDER=bedrock) ──────────────
# Before starting the app run: aws sso login --profile YOUR_PROFILE
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1
BEDROCK_PROFILE=                  # leave blank to use default AWS credential chain

# ── Option 3: OpenAI (LLM_PROVIDER=openai) ────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# ── Option 4: Ollama local LLM (LLM_PROVIDER=ollama) ──────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embeddings (kept for compatibility — vector search is disabled) ────────────
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=all-MiniLM-L6-v2


# ── Scheduler ─────────────────────────────────────────────────────────────────
# How often to auto-crawl (hours)
CRAWL_INTERVAL_HOURS=24

# Crawl once immediately when the app starts
CRAWL_ON_STARTUP=false

# Set to false to disable ALL automatic crawling (startup + interval).
# When false, crawls only run when you click "Crawl Now" in the UI.
CRAWL_SCHEDULE=false


# ── API Server ────────────────────────────────────────────────────────────────
# Bind address and port for the FastAPI/Uvicorn server.
# Use 0.0.0.0 to allow access from other machines on the same network.
API_HOST=127.0.0.1
API_PORT=8000


# ── HTTP Crawler ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=30
REQUEST_DELAY=2.0
MAX_RETRIES=3


# ── HCM Crawl Scope ───────────────────────────────────────────────────────────
# Additional HCM release codes to crawl (the hub only shows the current release).
# Comma-separated, e.g. HCM_EXTRA_RELEASES=26A,25D,25C
HCM_EXTRA_RELEASES=26A

# HCM module keyword filter — only crawl modules whose title contains one of these.
# Leave blank to crawl ALL modules from every hub.
# Comma-separated, e.g. HCM_MODULE_KEYWORDS=Compensation,Recruiting
HCM_MODULE_KEYWORDS=Human Resources,Human Capital Management,Recruiting,Opportunity Marketplace,Talent Management,Compensation,HCM Common,Common Technologies


# ── Corporate VPN / Proxy ─────────────────────────────────────────────────────
# If the crawl times out while on VPN, set your proxy here.
# Find it in: Edge → Settings → System → Proxy → Manual proxy setup
#
# Plain proxy:
#   HTTPS_PROXY=http://proxy.company.com:8080
#
# PAC file (the app resolves it automatically via pypac):
#   HTTPS_PROXY=http://proxy.company.com/proxy.pac
#
# Leave blank for direct internet access (e.g. on GCP or home network).
HTTPS_PROXY=
HTTP_PROXY=


# ── SSL Certificate Verification ──────────────────────────────────────────────
# If crawl fails with "certificate verify failed" errors (common on corporate VPN
# where a proxy performs SSL inspection), choose one of the two options below:
#
# Option A — Point to your corporate CA certificate (more secure, recommended):
#   1. Open Chrome/Edge → Settings → Privacy → Security → Manage certificates
#   2. Export your company's root CA as Base-64 encoded .cer or .pem
#   3. Set the path below:
# SSL_CERT_FILE=C:\certs\corporate-ca.pem
SSL_CERT_FILE=
#
# Option B — Disable SSL verification entirely (quick fix, less secure):
VERIFY_SSL=true


# ── Jira Integration ──────────────────────────────────────────────────────────
# Paste your Jira Personal Access Token here (recommended).
# How to get one:
#   1. Open Jira in your browser
#   2. Click your avatar → Profile → Personal Access Tokens
#   3. Create token (Read scope) → copy it → paste below
#   4. Restart the app
#
# Leave blank to try Windows SSPI (automatic, no config, but may not work
# with all corporate Jira configurations).
JIRA_PAT=


# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
