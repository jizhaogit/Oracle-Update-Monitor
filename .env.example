# Oracle OCI/OIC Monitor - Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Provider ──────────────────────────────────────────
# Options:
#   "anthropic" — Anthropic API key (ask IT for sk-ant-... key)
#   "bedrock"   — AWS Bedrock via SSO (no Anthropic key needed)
#   "openai"    — OpenAI API key
#   "ollama"    — Local Ollama (free, runs on your machine)
#   "none"      — Rule-based fallback only (default)
LLM_PROVIDER=none

# Anthropic direct API (LLM_PROVIDER=anthropic)
# Get key from IT or platform.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AWS Bedrock — Claude via company AWS SSO (LLM_PROVIDER=bedrock)
# Run "aws sso login --profile YOUR_PROFILE" before starting the app
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1
BEDROCK_PROFILE=                  # leave blank to use default AWS credential chain

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# Ollama local LLM (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ── Embeddings ─────────────────────────────────────────────
# Options: "huggingface" (local, default) | "openai"
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# ── Scheduler ──────────────────────────────────────────────
CRAWL_INTERVAL_HOURS=24
CRAWL_ON_STARTUP=true

# ── API Server ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── HTTP Crawler ───────────────────────────────────────────
REQUEST_TIMEOUT=30
REQUEST_DELAY=2.0
MAX_RETRIES=3

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
