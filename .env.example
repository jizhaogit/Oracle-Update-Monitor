# Oracle OCI/OIC Monitor - Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Provider ──────────────────────────────────────────
# Options: "openai" | "ollama" | "none" (rule-based fallback)
LLM_PROVIDER=none

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# Ollama local LLM (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ── Embeddings ─────────────────────────────────────────────
# Options: "huggingface" (local, default) | "openai"
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# ── Scheduler ──────────────────────────────────────────────
CRAWL_INTERVAL_HOURS=24
CRAWL_ON_STARTUP=true

# ── API Server ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── HTTP Crawler ───────────────────────────────────────────
REQUEST_TIMEOUT=30
REQUEST_DELAY=2.0
MAX_RETRIES=3

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
